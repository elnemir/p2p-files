FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build
WORKDIR /src
# Pin the complete upstream tree, including its nested dynamic/ext module.
ADD --checksum=sha256:b36539270ffdd167a0416f4b964c4fb60723be7266dae02c17db8779dc20b3db https://codeload.github.com/traefik/traefik/tar.gz/3bd7aa32e1b6c41166575529a10fb2346d9eaa2e /tmp/source.tar.gz
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src && rm /tmp/source.tar.gz
RUN go get golang.org/x/net@v0.60.0
# Large ACME provider SDKs need bounded compiler parallelism on a small CI host.
RUN GOMAXPROCS=2 GOMEMLIMIT=768MiB GOGC=50 CGO_ENABLED=0 go build -p 1 -trimpath -ldflags="-s -w -X github.com/traefik/traefik/v3/pkg/version.Version=3.7.14-filex.1" -o /traefik ./cmd/traefik
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates zlib=1.3.2-r1
COPY --from=build /traefik /usr/local/bin/traefik
USER 65532:65532
ENTRYPOINT ["traefik"]
