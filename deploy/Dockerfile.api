FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG FILEX_LICENSE_TRUST={}
ARG FILEX_RELEASE_TRUST={}
ARG FILEX_RELEASE_METADATA=
ARG FILEX_RELEASE_SOURCE=
RUN set -eu; for target in filex-api filex-worker filex-cli filex-verify; do CGO_ENABLED=0 go build -trimpath -ldflags "-X filex.local/filex/internal/licensing.ReleaseTrustJSON=${FILEX_LICENSE_TRUST} -X filex.local/filex/internal/licensing.ReleaseMetadataTrustJSON=${FILEX_RELEASE_TRUST} -X filex.local/filex/internal/licensing.ReleaseMetadataJWS=${FILEX_RELEASE_METADATA} -X filex.local/filex/internal/licensing.ReleaseSource=${FILEX_RELEASE_SOURCE}" -o /out/$target ./cmd/$target; done
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates zlib=1.3.2-r1 && mkdir -p /data/payload /data/artifacts /data/backups && chown -R 65532:65532 /data
COPY --from=build /out/ /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["filex-api"]
