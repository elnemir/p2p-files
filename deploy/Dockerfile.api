FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN set -eu; for target in filex-api filex-worker filex-cli filex-verify; do CGO_ENABLED=0 go build -trimpath -o /out/$target ./cmd/$target; done
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates zlib=1.3.2-r1 && mkdir -p /data/payload /data/artifacts /data/backups && chown -R 65532:65532 /data
COPY --from=build /out/ /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["filex-api"]
