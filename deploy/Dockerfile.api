FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN set -eu; for target in filex-api filex-worker filex-cli filex-verify; do CGO_ENABLED=0 go build -trimpath -o /out/$target ./cmd/$target; done
FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk add --no-cache ca-certificates zlib=1.3.2-r1 && mkdir -p /data/payload /data/artifacts /data/backups && chown -R 65532:65532 /data
COPY --from=build /out/ /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["filex-api"]
