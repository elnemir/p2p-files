FROM postgres:18-alpine@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
# gosu in this upstream image embeds a vulnerable, obsolete Go runtime.
# The official entrypoint only uses its user/group exec interface.
RUN apk add --no-cache su-exec=0.3-r0 zlib=1.3.2-r1 nghttp2-libs=1.70.0-r0 \
    && sed -i 's/exec gosu /exec su-exec /g' /usr/local/bin/docker-*.sh \
    && rm /usr/local/bin/gosu
