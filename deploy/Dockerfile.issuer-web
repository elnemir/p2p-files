FROM node:26-alpine@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5 AS build
WORKDIR /src
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json .npmrc ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/issuer/package.json ./apps/issuer/package.json
RUN npm ci
COPY apps/issuer ./apps/issuer
COPY apps/web/components/SetupWizard.tsx ./apps/web/components/SetupWizard.tsx
RUN npm run build --workspace @filex/issuer
FROM node:26-alpine@sha256:6f08a523443ddedf52941874c203475b0ad503e859ad70cb26ab8be9a517dbd5
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0
# The standalone server needs node only. Package managers are build-time tools.
RUN apk add --no-cache zlib=1.3.2-r1 && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn* /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build --chown=node:node /src/apps/issuer/.next/standalone ./
COPY --from=build --chown=node:node /src/apps/issuer/.next/static ./apps/issuer/.next/static
USER node
CMD ["node", "apps/issuer/server.js"]
