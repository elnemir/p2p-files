{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filex.invalid/schemas/webdav-credential-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "username": {
      "const": "filex"
    },
    "password": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "url",
    "username",
    "password",
    "expiresAt"
  ]
}
