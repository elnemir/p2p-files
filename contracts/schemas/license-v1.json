{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filex.invalid/schemas/license-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "issuer",
    "licenseId",
    "entitlementId",
    "revision",
    "customerId",
    "installationId",
    "kind",
    "issuedAt",
    "notBefore",
    "expiresAt",
    "updatesUntil",
    "supportUntil",
    "limits",
    "features"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "filex"
    },
    "issuer": {
      "const": "filex-vendor"
    },
    "licenseId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entitlementId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "installationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "kind": {
      "enum": [
        "subscription",
        "perpetual"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "notBefore": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatesUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "supportUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxEnabledUsers",
        "maxTransferBytes"
      ],
      "properties": {
        "maxEnabledUsers": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "maxTransferBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "webdav",
          "federated_auth",
          "white_label"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "subscription"
          }
        }
      },
      "then": {
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      },
      "else": {
        "properties": {
          "expiresAt": {
            "type": "null"
          }
        }
      }
    }
  ]
}
