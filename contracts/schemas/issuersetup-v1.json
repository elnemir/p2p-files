    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "clientSecret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "requiredAcr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
