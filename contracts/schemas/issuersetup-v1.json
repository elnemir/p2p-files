{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filex.invalid/schemas/issuersetup-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issuer",
    "clientId",
    "clientSecret",
