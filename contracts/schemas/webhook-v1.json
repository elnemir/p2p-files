{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filex.invalid/schemas/webhook-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "transfer.published",
        "transfer.expiring",
        "transfer.expired",
        "transfer.revoked",
        "download.completed"
      ]
    },
    "transferId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "type",
    "transferId"
  ]
}
