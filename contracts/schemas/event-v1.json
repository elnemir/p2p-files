{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filex.invalid/schemas/event-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "transfer.published",
        "transfer.expiring",
        "transfer.expired",
        "transfer.revoked",
        "download.completed"
      ]
    },
    "transferId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "readAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "transferId",
    "createdAt",
    "readAt"
  ]
}
