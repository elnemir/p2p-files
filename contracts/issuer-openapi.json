    "/issuer/auth/login": {
      "get": {
        "summary": "Start OIDC MFA authorization",
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect"
          },
          "401": {
            "description": "Invalid identity response"
          },
          "403": {
            "description": "MFA or subject rejected"
