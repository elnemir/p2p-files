{
  "name": "filex",
  "version": "0.1.0-dev",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "apps/web",
    "apps/issuer"
  ],
  "scripts": {
    "contracts": "node scripts/check_contracts.mjs",
    "test:contracts": "node --test scripts/contracts.test.mjs scripts/e2e-contracts.test.mjs",
    "check:dependencies": "node scripts/check_dependencies.mjs",
    "test:toolchain": "node --test scripts/dependencies.test.mjs scripts/lint.test.mjs",
    "typecheck": "npm run typecheck --workspace @filex/web && npm run typecheck --workspace @filex/issuer",
    "build": "npm run build --workspace @filex/web && npm run build --workspace @filex/issuer",
    "lint": "eslint apps/web apps/issuer --max-warnings 0",
    "format:check": "prettier --check \"apps/{web,issuer}/**/*.{ts,tsx,css}\"",
    "generate:types": "node scripts/check_generated_types.mjs --write",
    "check:types": "node scripts/check_generated_types.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@asyncapi/parser": "3.6.4",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "js-yaml": "5.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
